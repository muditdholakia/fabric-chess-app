{
  "name": "fabric-chess-arena",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A zero-dependency chess game, deployable as a native Microsoft Fabric App with Rayfin.",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "fabric:dev": "npx rayfin dev",
    "deploy": "npx rayfin up",
    "deploy:status": "npx rayfin up status",
    "deploy:check": "npx rayfin up --dry-run"
  },
  "engines": {"node": ">=20"},
  "license": "MIT"
}
